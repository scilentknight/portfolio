# Environment Variables for Portfolio Contact Form
# Copy this file to .env.local and fill in your credentials.
# NEVER commit .env.local to version control.

# ─── SMTP Email Configuration ───────────────────────────────────────────────
# For Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your.email@gmail.com
#   SMTP_PASS=your_app_password   (use Gmail App Password, not your account password)
#
# For other providers (Zoho, Outlook, Fastmail, etc.), check their SMTP settings.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASS=your_16_char_app_password

# ─── Contact Form Receiver ───────────────────────────────────────────────────
# The email address where contact form submissions will be delivered.
CONTACT_RECEIVER=scilentknight512@gmail.com
